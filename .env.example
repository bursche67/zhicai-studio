APP_DB=data/app.db
APP_STORAGE=data/uploads
APP_PUBLIC_MODE=false
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=
# Public deployment only: real domain resolving to the server IP.
APP_DOMAIN=
MODEL_BASE_URL=http://127.0.0.1:8001/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_PARAMETER_SIZE=
MODEL_TIMEOUT=120
MODEL_CHUNK_CHARS=12000
MODEL_MAX_TOKENS=4096
MODEL_RETRIES=1
# Provider-specific. DeepSeek reasoning can exhaust the output limit; use disabled for extraction.
MODEL_THINKING=
# Local loopback only by default. Explicitly opt in for an external endpoint.
MODEL_ALLOW_REMOTE=false
# Optional legacy internal cap; blank disables. This is NOT the DeepSeek balance.
# Current deployment leaves it blank and displays /api/model-balance instead.
# Audited only for official https://api.deepseek.com + deepseek-flash.
MODEL_BUDGET_CNY=
MODEL_JSON_MODE=false
SOFFICE_PATH=
TESSERACT_CMD=
